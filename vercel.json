{
  "framework": null,
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/admin/overview",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/investment",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/dishes",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/categories",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/restaurant",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/links",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/ads",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/ratings",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/analytics",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/messages",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/staff",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/account",
      "destination": "/admin/index.html"
    },
    {
      "source": "/welcome",
      "destination": "/index.html"
    },
    {
      "source": "/menu",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "snouno.vercel.app"
        }
      ],
      "destination": "https://snounu-restaurant.vercel.app/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "snouno.vercel.app"
        }
      ],
      "destination": "https://snounu-restaurant.vercel.app/:path*",
      "permanent": true
    }
  ]
}
